{
  "manifest_version": 3,
  "name": "Pagewright",
  "version": "1.0.1",
  "description": "Convert any webpage into a clean, professional PDF in one click",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "*://*/*",
    "https://api.groq.com/*",
    "http://localhost:11434/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Pagewright - PDF Converter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["content-script.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
